{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "seed": "ts-node src/scripts/seed.ts",
    "db:init": "bash -lc 'set -a && source .env && set +a && for file in $(find db/migrations -maxdepth 1 -type f -name \"*.sql\" | sort); do psql \"$DATABASE_URL\" -f \"$file\"; done'",
    "db:check": "bash -lc 'set -a && source .env && set +a && psql \"$DATABASE_URL\" -c \"select current_user, current_database();\"'"
  },
  "keywords": [],
  "author": "pccork",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@10.30.0",
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/jwt": "^10.0.0",
    "@fastify/sensible": "^6.0.4",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.3.1",
    "fastify": "^5.7.4",
    "fastify-plugin": "^5.1.0",
    "pg": "^8.18.0",
    "shared-types": "workspace:*"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^25.2.3",
    "@types/pg": "^8.16.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
